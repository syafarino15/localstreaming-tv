{
  "name": "stayin-local-tv",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "cross-env EXPO_TV=1 expo prebuild --clean",
    "build:apk": "cross-env EXPO_TV=1 expo prebuild --clean && cd android && gradlew.bat :app:assembleRelease",
    "typecheck": "tsc --noEmit",
    "gen:api": "node scripts/gen-api.mjs"
  },
  "dependencies": {
    "babel-preset-expo": "~58.0.0",
    "expo": "58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-keep-awake": "~58.0.4",
    "expo-linear-gradient": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88-stable",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native-tvos/config-tv": "^0.1.4",
    "@types/react": "~19.3.0",
    "cross-env": "^7.0.3",
    "openapi-typescript": "^7.4.4",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  }
}
